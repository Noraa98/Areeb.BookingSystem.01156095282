@using Areeb.BookingSystemV01.BLL.Models.Roles;
@model IEnumerable<RoleReadDto>

@{
    ViewData["Title"] = "Roles";
}

<h2 class="mb-4">Roles</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add New Role</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th style="width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


