@using Areeb.BookingSystemV01.BLL.Models.Events;
@model EventReadDto

@{
    ViewData["Title"] = "Event Details";
}

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded" style="max-height: 400px; object-fit: cover;" />
    </div>
    <div class="col-md-6">
        <h2>@Model.EventName</h2>
        <p>@Model.Description</p>
        <p><strong>Date:</strong> @Model.EventDate.ToShortDateString()</p>
        <p><strong>Venue:</strong> @Model.Venue</p>
        <p><strong>Price:</strong> $@Model.Price</p>
        <p><strong>Category:</strong> @Model.Category</p>

        @if (Model.IsActive)
        {
            <div class="alert alert-success mt-3">You have already booked this event.</div>
        }
        else
        {
            <form asp-controller="Booking" asp-action="Create" method="post">
                <input type="hidden" name="eventId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary mt-3">Book Now</button>
            </form>
        }

        <a asp-action="Index" class="btn btn-secondary mt-3">Back to Events</a>
    </div>
</div>


