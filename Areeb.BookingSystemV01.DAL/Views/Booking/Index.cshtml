@using Areeb.BookingSystemV01.BLL.Models.Bookings;
@model IEnumerable<BookingDto>

@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (!Model.Any())
{
    <p>You have not booked any events yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.EventName</td>
                    <td>@booking.EventDate.ToString("dd MMM yyyy")</td>
                    @* <td>@booking.Venue</td> *@
                    <td>$@booking.TotalPrice</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@booking.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


